# Backend base URL. API paths already include /api (e.g. /api/incidents).
VITE_API_URL=http://localhost:5000

# Serve every request from the in-browser sample data layer (src/services/mock).
# Defaults to true until the backend is ready. Set to false to call the backend.
VITE_USE_MOCKS=true

# Initial map view: "lat,lng,zoom". Defaults to Bengaluru.
VITE_MAP_CENTER=12.9716,77.5946,12
